{
  "name": "dsh-clean-desktop-shell",
  "version": "0.5.2",
  "description": "Desktop companion for DeepSeek Harness (DSH) as a DSH plugin — system tray plus an edge-docked task bubble, no window of its own: the DSH page stays in your browser. DSH 插件形态的桌面辅助壳：托盘 + 任务气泡，不接管浏览器。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzd-loostone/dsh-clean-desktop-shell.git"
  },
  "homepage": "https://github.com/lzd-loostone/dsh-clean-desktop-shell#readme",
  "bugs": {
    "url": "https://github.com/lzd-loostone/dsh-clean-desktop-shell/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "electron/",
    "src/",
    "scripts/",
    "assets/delegation/**",
    "build/icon.png",
    "build/icon.ico",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CONTRIBUTORS.md",
    "LICENSE",
    "version.txt"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./delegation": "./lib/host/delegation.js",
    "./delegation-gate": "./lib/host/delegation-gate.js",
    "./delegation-gate-ports": "./lib/host/delegation-gate-ports.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/selftest-runtime.mjs && node scripts/check-preset-snapshot.mjs",
    "dev": "electron electron/main.js",
    "test": "node --test \"electron/*.test.js\" \"src/host/*.test.js\" \"src/client/*.test.js\"",
    "icons": "node scripts/gen-icons.mjs",
    "pack": "electron-builder --win nsis",
    "pack:mac": "electron-builder --mac dmg",
    "test:contract": "node scripts/run-contract-tests.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.icather.dsh-clean-desktop-shell",
    "productName": "DSH Clean Desktop Shell",
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/koffi-*/**"
    ],
    "files": [
      "electron/**/*",
      "!electron/**/*.test.js",
      "lib/**/*",
      "src/**/*",
      "!src/**/*.test.js",
      "build/icon.png",
      "package.json",
      "cordis.patch.yml"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "lzd-loostone",
      "repo": "dsh-clean-desktop-shell"
    }
  },
  "license": "MIT",
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.4",
    "semver": "^7.7.2"
  },
  "desktopShell": {
    "electronVersion": "33.4.11"
  }
}
